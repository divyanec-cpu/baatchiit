{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/pipeline.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/download", "destination": "/download.html" }
  ],
  "headers": [
    {
      "source": "/BaatChiit.ai.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"BaatChiit.ai.apk\"" }
      ]
    }
  ]
}
